RewriteEngine On

# Service area URLs: serve the landing page and nested city pages.
RewriteCond %{THE_REQUEST} \s/+(.*/)?city-shop(?:\.html)?[?\s] [NC]
RewriteRule ^city-shop(?:\.html)?/?$ /%1service-area [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?service-area/+[?\s] [NC]
RewriteRule ^service-area/$ /%1service-area [R=301,L,NE]
RewriteRule ^service-area$ service-area.html [END]
# Correct the legacy Bonosree service-area slug.
RewriteCond %{THE_REQUEST} \s/+(.*/)?curtain-shop-in-bonosree(?:\.html)?/?[?\s] [NC]
RewriteRule ^curtain-shop-in-bonosree(?:\.html)?/?$ /%1service-area/curtain-shop-in-banasree [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?service-area/curtain-shop-in-bonosree(?:\.html)?/?[?\s] [NC]
RewriteRule ^service-area/curtain-shop-in-bonosree(?:\.html)?/?$ /%1service-area/curtain-shop-in-banasree [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(.*/)?(?:curtain-shop-in-banani|curtain-shop-in-baridhara|curtain-shop-in-bashundhara|curtain-shop-in-banasree|curtain-shop-in-chittagong|curtain-shop-in-dhanmondi|curtain-shop-in-elephant-road|curtain-shop-in-gulshan-2|curtain-shop-in-mohakhali|curtain-shop-in-narayanganj|curtain-shop-in-nikunja|curtain-shop-in-old-dhaka|curtain-shop-in-rajshahi|curtain-shop-in-sylhet|curtain-shop-in-uttara|curtain-shop-in-wari)(?:\.html)?[?\s] [NC]
RewriteRule ^(curtain-shop-in-banani|curtain-shop-in-baridhara|curtain-shop-in-bashundhara|curtain-shop-in-banasree|curtain-shop-in-chittagong|curtain-shop-in-dhanmondi|curtain-shop-in-elephant-road|curtain-shop-in-gulshan-2|curtain-shop-in-mohakhali|curtain-shop-in-narayanganj|curtain-shop-in-nikunja|curtain-shop-in-old-dhaka|curtain-shop-in-rajshahi|curtain-shop-in-sylhet|curtain-shop-in-uttara|curtain-shop-in-wari)(?:\.html)?/?$ /%1service-area/$1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?service-area/(?:curtain-shop-in-banani|curtain-shop-in-baridhara|curtain-shop-in-bashundhara|curtain-shop-in-banasree|curtain-shop-in-chittagong|curtain-shop-in-dhanmondi|curtain-shop-in-elephant-road|curtain-shop-in-gulshan-2|curtain-shop-in-mohakhali|curtain-shop-in-narayanganj|curtain-shop-in-nikunja|curtain-shop-in-old-dhaka|curtain-shop-in-rajshahi|curtain-shop-in-sylhet|curtain-shop-in-uttara|curtain-shop-in-wari)\.html[?\s] [NC]
RewriteRule ^service-area/(curtain-shop-in-banani|curtain-shop-in-baridhara|curtain-shop-in-bashundhara|curtain-shop-in-banasree|curtain-shop-in-chittagong|curtain-shop-in-dhanmondi|curtain-shop-in-elephant-road|curtain-shop-in-gulshan-2|curtain-shop-in-mohakhali|curtain-shop-in-narayanganj|curtain-shop-in-nikunja|curtain-shop-in-old-dhaka|curtain-shop-in-rajshahi|curtain-shop-in-sylhet|curtain-shop-in-uttara|curtain-shop-in-wari)\.html$ /%1service-area/$1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?service-area/(?:curtain-shop-in-banani|curtain-shop-in-baridhara|curtain-shop-in-bashundhara|curtain-shop-in-banasree|curtain-shop-in-chittagong|curtain-shop-in-dhanmondi|curtain-shop-in-elephant-road|curtain-shop-in-gulshan-2|curtain-shop-in-mohakhali|curtain-shop-in-narayanganj|curtain-shop-in-nikunja|curtain-shop-in-old-dhaka|curtain-shop-in-rajshahi|curtain-shop-in-sylhet|curtain-shop-in-uttara|curtain-shop-in-wari)/+[?\s] [NC]
RewriteRule ^service-area/(curtain-shop-in-banani|curtain-shop-in-baridhara|curtain-shop-in-bashundhara|curtain-shop-in-banasree|curtain-shop-in-chittagong|curtain-shop-in-dhanmondi|curtain-shop-in-elephant-road|curtain-shop-in-gulshan-2|curtain-shop-in-mohakhali|curtain-shop-in-narayanganj|curtain-shop-in-nikunja|curtain-shop-in-old-dhaka|curtain-shop-in-rajshahi|curtain-shop-in-sylhet|curtain-shop-in-uttara|curtain-shop-in-wari)/$ /%1service-area/$1 [R=301,L,NE]
RewriteRule ^service-area/(curtain-shop-in-banani|curtain-shop-in-baridhara|curtain-shop-in-bashundhara|curtain-shop-in-banasree|curtain-shop-in-chittagong|curtain-shop-in-dhanmondi|curtain-shop-in-elephant-road|curtain-shop-in-gulshan-2|curtain-shop-in-mohakhali|curtain-shop-in-narayanganj|curtain-shop-in-nikunja|curtain-shop-in-old-dhaka|curtain-shop-in-rajshahi|curtain-shop-in-sylhet|curtain-shop-in-uttara|curtain-shop-in-wari)$ service-area/$1.html [END]


# Serve the main blog listing at /blog even though /blog is also a real folder.
RewriteCond %{THE_REQUEST} \s/+(.*/)?blog/+[?\s] [NC]
RewriteRule ^blog/$ /%1blog [R=301,L,NE]
RewriteRule ^blog$ blog.html [END]

# Blog article URLs: redirect legacy root slugs and serve existing HTML at /blog/{slug}
RewriteCond %{THE_REQUEST} \s/+(.*/)?(?:best-curtain-for-winter-weather|best-curtains-for-hot-weather|best-dining-room-curtain|best-office-curtains|curtain-cleaning-guide|curtain-price-in-bangladesh|hotel-curtain|how-to-measure-a-window-for-curtains|luxury-bedroom-curtain-bangladesh|premium-living-room-curtain|resort-curtain|small-bedroom-curtains)(?:[?\s]) [NC]
RewriteRule ^(best-curtain-for-winter-weather|best-curtains-for-hot-weather|best-dining-room-curtain|best-office-curtains|curtain-cleaning-guide|curtain-price-in-bangladesh|hotel-curtain|how-to-measure-a-window-for-curtains|luxury-bedroom-curtain-bangladesh|premium-living-room-curtain|resort-curtain|small-bedroom-curtains)/?$ /%1blog/$1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?blog/(?:best-curtain-for-winter-weather|best-curtains-for-hot-weather|best-dining-room-curtain|best-office-curtains|curtain-cleaning-guide|curtain-price-in-bangladesh|hotel-curtain|how-to-measure-a-window-for-curtains|luxury-bedroom-curtain-bangladesh|premium-living-room-curtain|resort-curtain|small-bedroom-curtains)\.html[?\s] [NC]
RewriteRule ^blog/(best-curtain-for-winter-weather|best-curtains-for-hot-weather|best-dining-room-curtain|best-office-curtains|curtain-cleaning-guide|curtain-price-in-bangladesh|hotel-curtain|how-to-measure-a-window-for-curtains|luxury-bedroom-curtain-bangladesh|premium-living-room-curtain|resort-curtain|small-bedroom-curtains)\.html$ /%1blog/$1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?blog/(?:best-curtain-for-winter-weather|best-curtains-for-hot-weather|best-dining-room-curtain|best-office-curtains|curtain-cleaning-guide|curtain-price-in-bangladesh|hotel-curtain|how-to-measure-a-window-for-curtains|luxury-bedroom-curtain-bangladesh|premium-living-room-curtain|resort-curtain|small-bedroom-curtains)/+[?\s] [NC]
RewriteRule ^blog/(best-curtain-for-winter-weather|best-curtains-for-hot-weather|best-dining-room-curtain|best-office-curtains|curtain-cleaning-guide|curtain-price-in-bangladesh|hotel-curtain|how-to-measure-a-window-for-curtains|luxury-bedroom-curtain-bangladesh|premium-living-room-curtain|resort-curtain|small-bedroom-curtains)/$ /%1blog/$1 [R=301,L,NE]
RewriteRule ^blog/(best-curtain-for-winter-weather|best-curtains-for-hot-weather|best-dining-room-curtain|best-office-curtains|curtain-cleaning-guide|curtain-price-in-bangladesh|hotel-curtain|how-to-measure-a-window-for-curtains|luxury-bedroom-curtain-bangladesh|premium-living-room-curtain|resort-curtain|small-bedroom-curtains)$ blog/$1.html [L]


# Correct the legacy misspelled Uttara city-page slug
RewriteCond %{THE_REQUEST} \s/+(.*/)?curtain-shop-in-uttura(?:[?\s]) [NC]
RewriteRule ^curtain-shop-in-uttura/?$ /%1curtain-shop-in-uttara [R=301,L,NE]

# ১. কেউ যদি index, index.html বা index.php লিখে ঢোকার চেষ্টা করে, তাকে মেইন ডোমেইনে পাঠাও
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(html|php|htm)\ HTTP/ [NC,OR]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\ HTTP/ [NC]
RewriteRule ^index(\.html|\.php|\.htm)?$ https://curtivelle.com/ [R=301,L]

# ২. ডিরেক্টরি ইনডেক্স সেট করা যাতে সার্ভার নিজে থেকে /index না খোঁজে
DirectoryIndex index.html


# ৩. যেকোনো পেজের শেষে .html লিখে সার্চ করলে তাকে ক্লিন ইউআরএলে ফোর্স রিডাইরেক্ট করবে
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ৪. ইন্টারনাল রুল: ইউআরএলে .html না থাকলেও সার্ভার যেন ফাইলটি চেনে
# Local/prod: Remove trailing slash from clean HTML page URLs so relative assets load correctly
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^ %1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]