RewriteEngine On

# ১. index.html বা শুধু index লেখা থাকলে রুট ডোমেইনে (/) পাঠিয়ে দেবে
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(html|php)\ HTTP/
RewriteRule ^index\.(html|php)$ / [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\ HTTP/
RewriteRule ^index$ / [R=301,L]

# ২. কেউ .html দিয়ে সার্চ করলে তাকে জোর করে (Force) ক্লিন ইউআরএলে রিডাইরেক্ট করবে
# (যেমন: small-bedroom-curtains.html লিখলে অটোমেটিক small-bedroom-curtains হয়ে যাবে)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html\ HTTP/
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# ৩. ইন্টারনাল রুল: সার্ভারকে বলা যেন .html ছাড়া ফাইল লোড করতে পারে
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]